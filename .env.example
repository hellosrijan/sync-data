# Copy to .env and adjust. .env is git-ignored; never commit real secrets.

# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Postgres (used by docker-compose and Django) ---
POSTGRES_DB=sync_data
POSTGRES_USER=sync_data
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis (dramatiq broker) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Salesforce record API (outbound sync)
SALESFORCE_BASE_URL=https://example.my.salesforce.com
SALESFORCE_TOKEN=changeme
SALESFORCE_INTEGRATION_USER=integration-user@example.invalid
SALESFORCE_RATE_LIMIT=90
